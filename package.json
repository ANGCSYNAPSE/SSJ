{
  "name": "ssj",
  "version": "0.1.0",
  "private": true,
  "description": "Shree Shyam Jagat — Next.js frontend and Express API, each self-contained.",
  "scripts": {
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "build:web": "npm --prefix frontend run build",
    "start:web": "npm --prefix frontend run start",
    "start:api": "npm --prefix backend run start",
    "lint:web": "npm --prefix frontend run lint",
    "migrate": "npm --prefix backend run migrate"
  }
}
