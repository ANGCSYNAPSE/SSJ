# Copy this file to .env.local and fill in real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the backend API (see backend/). All Razorpay keys now live
# server-side in backend/.env.example — the frontend never touches them
# directly, it just calls backend/api/v1/donations/*.
NEXT_PUBLIC_API_URL=http://localhost:5000
