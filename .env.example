# Copy this file to .env.local and fill in real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the backend API (see backend/). All Razorpay keys now live
# server-side in backend/.env.example — the frontend never touches them
# directly, it just calls backend/api/v1/donations/*.
NEXT_PUBLIC_API_URL=https://ssj-backend-seven.vercel.app

# Sign in with Google: paste the OAuth Web client id (ends in .apps.googleusercontent.com). Public, no secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=751051334242-94j672ue7ki6vumlah4f6rotn5d4hhaf.apps.googleusercontent.com
